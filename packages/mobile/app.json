{
  "expo": {
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "0f1f6641-2847-4b02-9961-7d1354754b44"
      },
      "router": {
        "origin": false
      }
    },
    "icon": "./assets/icon.png",
    "ios": {
      "buildNumber": "3",
      "bundleIdentifier": "ai.shadow.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSBonjourServices": [
          "_http._tcp"
        ],
        "NSFaceIDUsageDescription": "SHADOW uses Face ID to protect the app",
        "NSLocalNetworkUsageDescription": "SHADOW connects to your Shadow Node on the local network",
        "UIFileSharingEnabled": true
      },
      "supportsTablet": true
    },
    "name": "SHADOW",
    "newArchEnabled": true,
    "orientation": "portrait",
    "owner": "heynerd",
    "platforms": [
      "ios"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#100F0F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/IBMPlexSans-Regular.ttf",
            "./assets/fonts/IBMPlexSans-Medium.ttf",
            "./assets/fonts/IBMPlexSans-SemiBold.ttf",
            "./assets/fonts/IBMPlexSans-Bold.ttf",
            "./assets/fonts/IBMPlexMono-Regular.ttf",
            "./assets/fonts/IBMPlexMono-Medium.ttf",
            "./assets/fonts/IBMPlexMono-SemiBold.ttf",
            "./assets/fonts/IBMPlexMono-Bold.ttf"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow SHADOW to use Face ID to protect the app"
        }
      ],
      [
        "expo-file-system",
        {
          "enableFileSharing": true,
          "supportsOpeningDocumentsInPlace": true
        }
      ]
    ],
    "scheme": "shadow",
    "slug": "shadow",
    "splash": {
      "backgroundColor": "#100F0F",
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain"
    },
    "userInterfaceStyle": "automatic",
    "version": "1.2.0"
  }
}
